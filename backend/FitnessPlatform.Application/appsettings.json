{
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=fitness_dev;Username=fitness_admin",
    "MongoDB": "mongodb://admin:{0}@localhost:27017/?authSource=admin"
  },
  "MongoDB": {
    "DatabaseName": "fitness_dev"
  },
  "Jwt": {
    "Issuer": "FitnessPlatform",
    "Audience": "FitnessPlatform",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "BucketName": "fitness-platform"
  },
  "App": {
    "BaseUrl": "http://localhost:5173"
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "FromAddress": "noreply@fitnessplatform.local",
    "FromName": "Fitness Platform"
  },
  "OpenFoodFacts": {
    "BaseUrl": "https://world.openfoodfacts.org/",
    "TimeoutSeconds": 30,
    "CacheDays": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
