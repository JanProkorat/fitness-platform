<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="FastEndpoints" Version="8.0.1" />
    <PackageReference Include="FastEndpoints.Security" Version="8.0.1" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.0.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="Resend" Version="0.2.2" />
    <PackageReference Include="Minio" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.4.0" />
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.4.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.7.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="**/*.resx" />
    <EmbeddedResource Remove="**/*.razor" />
    <EmbeddedResource Remove="**/*.cshtml" />
    <None Remove="Infrastructure\EmailTemplates\EmailVerification.cs.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\EmailVerification.cs.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Infrastructure\EmailTemplates\EmailVerification.de.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\EmailVerification.de.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Infrastructure\EmailTemplates\EmailVerification.en.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\EmailVerification.en.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Infrastructure\EmailTemplates\Invitation.cs.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\Invitation.cs.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Infrastructure\EmailTemplates\Invitation.de.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\Invitation.de.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Infrastructure\EmailTemplates\Invitation.en.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\Invitation.en.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Infrastructure\EmailTemplates\PasswordReset.cs.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\PasswordReset.cs.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Infrastructure\EmailTemplates\PasswordReset.de.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\PasswordReset.de.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Infrastructure\EmailTemplates\PasswordReset.en.html" />
    <EmbeddedResource Include="Infrastructure\EmailTemplates\PasswordReset.en.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
