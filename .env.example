# =========================
# PostgreSQL
# =========================
POSTGRES_USER=fitness_admin
POSTGRES_PASSWORD=fitness_dev_password
POSTGRES_DB=fitness_dev
POSTGRES_PORT=5432

# =========================
# MongoDB
# =========================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=mongo_dev_password
MONGO_PORT=27017

# =========================
# MinIO (S3-compatible blob storage)
# =========================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =========================
# ASP.NET Core
# =========================
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars!!

# =========================
# MailHog (dev SMTP)
# =========================
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
