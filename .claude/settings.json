{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push * --force-with-lease)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(dotnet ef database drop *)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(node*)",
      "Bash(nc*)",
      "Bash(ncat*)",
      "Bash(telnet*)",
      "Bash(eval*)",
      "Bash(source *)",
      "Bash(. *)",
      "Edit(**/.env*)",
      "Edit(**/appsettings.*.json)",
      "Edit(**/secrets.json)",
      "Edit(**/*.pfx)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Write(**/.env*)",
      "Write(**/appsettings.*.json)",
      "Write(**/secrets.json)",
      "Write(**/*.pfx)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Bash(*>*.env*)",
      "Bash(*>>*.env*)",
      "Bash(*>*secrets*)",
      "Bash(*>>*secrets*)",
      "Bash(*>*appsettings*)",
      "Bash(*>>*appsettings*)",
      "Bash(*>*.pfx)",
      "Bash(*>*.key)",
      "Bash(*>*.pem)",
      "Bash(*>>*.pem)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet ef migrations add:*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.json)",
      "Bash(python3*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/split-compound-commands.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-subagent-merge.py"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-bash-allowlist.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-specs.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-state-writes.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-generated-client.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear|resume|startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/reinject-state.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/build-on-stop.py"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-on-stop.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/build-on-submit.py"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-on-submit.sh"
          }
        ]
      }
    ]
  }
}
