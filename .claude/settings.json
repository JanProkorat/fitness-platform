{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",

      "Bash(git push -u origin feature/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push -u origin refactor/:*)",
      "Bash(git push -u origin docs/:*)",
      "Bash(git push -u origin chore/:*)",
      "Bash(git push -u origin spike/:*)",
      "Bash(git push origin feature/:*)",
      "Bash(git push origin fix/:*)",
      "Bash(git push origin refactor/:*)",
      "Bash(git push origin docs/:*)",
      "Bash(git push origin chore/:*)",
      "Bash(git push origin spike/:*)"
    ],
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Edit(**/.env*)",
      "Edit(**/appsettings.*.json)",
      "Edit(**/secrets.json)",
      "Edit(**/*.pfx)",
      "Edit(**/*.key)",
      "Write(**/.env*)",
      "Write(**/appsettings.*.json)",
      "Write(**/secrets.json)",
      "Bash(*>*.env*)",
      "Bash(*>>*.env*)",
      "Bash(*>*secrets*)",
      "Bash(*>>*secrets*)",
      "Bash(*>*.pfx)",
      "Bash(*>*.key)",
      "Edit(web/src/api/generated.ts)",
      "Write(web/src/api/generated.ts)",
      "Edit(mobile/src/api/generated.ts)",
      "Write(mobile/src/api/generated.ts)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge * develop)",
      "Bash(gh pr merge * main)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet ef migrations add:*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/split-compound-commands.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-subagent-merge.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-bash-allowlist.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated-edits.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-submit.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear|resume|startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/reinject-state.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-task-flow.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-check.sh\""
          }
        ]
      }
    ]
  }
}
