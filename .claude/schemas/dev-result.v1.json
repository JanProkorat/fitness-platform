{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".claude/schemas/dev-result.v1.json",
  "title": "Developer Result v1",
  "type": "object",
  "required": ["wi_id", "files_changed", "hit_max_turns", "notes", "verification"],
  "properties": {
    "$schema":        { "const": ".claude/schemas/dev-result.v1.json" },
    "wi_id":          { "type": "string", "pattern": "^WI-\\d+$" },
    "files_changed":  { "type": "array", "items": { "type": "string", "maxLength": 400 } },
    "tests_added":    { "type": "integer", "minimum": 0 },
    "tests_passing":  { "type": "boolean" },
    "coverage_delta": { "type": "string", "maxLength": 50 },
    "hit_max_turns":  { "type": "boolean" },
    "notes":          { "type": "string", "maxLength": 2000 },
    "verification_output": { "type": "string", "maxLength": 4000 },
    "verification":   {
      "description": "Which check the developer actually executed, mirroring the WI's declared verification.tool. Disambiguates tests_passing: a build-only WI runs no tests, so tests_passing carries no signal there. Required. 'tool' is a free-form non-empty string so any pack (dotnet-test, dotnet-build, swift-test, ...) can populate it; a pack-specific schema extension may narrow it with its own enum.",
      "type": "object",
      "required": ["tool", "passed"],
      "properties": {
        "tool":   { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "$schema": ".claude/schemas/dev-result.v1.json",
      "wi_id": "WI-1",
      "files_changed": ["src/{Project}/Features/Tasks/ReassignTask.cs", "tests/{Project}.Tests/Tasks/ReassignTaskTests.cs"],
      "tests_added": 3,
      "tests_passing": true,
      "coverage_delta": "+0.8%",
      "hit_max_turns": false,
      "notes": "Used AppDbContext directly per rules/architecture.md#no-repository-pattern. No repository added.",
      "verification": { "tool": "dotnet-test", "passed": true }
    }
  ]
}
