{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".claude/schemas/pipeline-state.v1.json",
  "title": "Pipeline State v1",
  "type": "object",
  "required": ["uc_id", "phase", "gates_passed"],
  "properties": {
    "$schema":            { "type": "string" },
    "uc_id":              { "type": "string", "pattern": "^UC-\\d{3,}$" },
    "slug":               { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "jira_key":           { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-\\d+$" },
    "spec_path":          { "type": "string" },
    "work_items_path":    { "type": "string" },
    "phase":              { "enum": ["interview", "design", "design-review", "impl", "implementing", "quality-gate", "ship", "done"] },
    "active_wi":          { "type": ["string", "null"], "pattern": "^WI-\\d+$" },
    "gates_passed":       { "type": "array", "items": { "enum": ["A", "B", "C", "D", "E"] } },
    "review_rounds":      { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "awaiting_user_gate": { "type": ["string", "null"], "enum": [null, "A", "B", "C", "D", "E"] },
    "complexity_tag":     { "enum": ["routine", "moderate", "novel"], "description": "Recorded in Phase 1. Gates conductor's optional kit specialists (Phase 2) and Gate A+B collapsing." },
    "notes":              { "type": "string", "maxLength": 2000 },
    "last_update":        { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "$schema": ".claude/schemas/pipeline-state.v1.json",
      "uc_id": "UC-042",
      "slug": "reassign-pipeline-task",
      "jira_key": "PROJ-306",
      "spec_path": "docs/specs/in-progress/042_UC_042_reassign.md",
      "work_items_path": "docs/specs/in-progress/reassign-work-items.md",
      "phase": "impl",
      "active_wi": "WI-3",
      "gates_passed": ["A", "B", "C"],
      "review_rounds": { "WI-3": 1 },
      "awaiting_user_gate": "D",
      "notes": "Round 2 design review clean; starting developer on WI-3.",
      "last_update": "2026-04-17T14:33:00+02:00"
    }
  ]
}
