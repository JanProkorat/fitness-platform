{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".claude/schemas/spec.v1.json",
  "title": "UC Spec v1",
  "type": "object",
  "required": ["$schema", "uc_id", "slug", "title", "actors", "main_flow", "acceptance_criteria"],
  "properties": {
    "$schema":           { "const": ".claude/schemas/spec.v1.json" },
    "uc_id":             { "type": "string", "pattern": "^UC-\\d{3,}$" },
    "slug":              { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title":             { "type": "string", "minLength": 3 },
    "actors":            { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "preconditions":     { "type": "array", "items": { "type": "string" } },
    "main_flow":         { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "alternate_flows":   { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "out_of_scope":      { "type": "array", "items": { "type": "string" } },
    "non_functional":    { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "examples": [
    {
      "$schema": ".claude/schemas/spec.v1.json",
      "uc_id": "UC-042",
      "slug": "reassign-pipeline-task",
      "title": "Allow supervisors to reassign pipeline tasks",
      "actors": ["Supervisor"],
      "preconditions": ["User has Supervisor role"],
      "main_flow": ["Supervisor opens pipeline view", "Supervisor selects task and target user", "System reassigns and writes audit entry"],
      "acceptance_criteria": ["Reassignment is logged with actor + timestamp", "Non-supervisor gets 403"],
      "out_of_scope": ["Bulk reassignment UI"],
      "non_functional": ["P95 < 300ms"]
    }
  ]
}
