{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".claude/schemas/impl-review.v1.json",
  "title": "Implementation Review v1",
  "type": "object",
  "required": ["$schema", "kind", "wi_id", "commit_range", "findings", "summary", "blocks_merge"],
  "properties": {
    "$schema":      { "const": ".claude/schemas/impl-review.v1.json" },
    "kind":         { "const": "impl" },
    "wi_id":        { "type": "string", "pattern": "^WI-\\d+$" },
    "commit_range": { "type": "string", "description": "e.g. 'staged' or 'HEAD~1..HEAD' or commit hash range" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "rule", "file", "detail"],
        "properties": {
          "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "rule":     { "type": "string", "maxLength": 200, "pattern": "^(rules/[a-z0-9-]+\\.md#[a-z0-9-]+|skills/[a-z0-9-]+/(SKILL\\.md|references/[a-z0-9-]+\\.md)#[a-z0-9-]+|CLAUDE\\.md → [A-Za-z0-9_. -]+)$", "description": "Descriptive anchor reference, e.g. 'rules/csharp-style.md#guard-clauses' or 'CLAUDE.md → Code Conventions'" },
          "file":     { "type": "string", "maxLength": 400 },
          "hunk":     { "type": "string", "maxLength": 200, "description": "Git diff hunk header, e.g. '@@ -10,6 +10,8 @@'" },
          "line":     { "type": "integer", "minimum": 1 },
          "detail":   { "type": "string", "minLength": 5, "maxLength": 2000 }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
      "properties": {
        "CRITICAL": { "type": "integer", "minimum": 0 },
        "HIGH":     { "type": "integer", "minimum": 0 },
        "MEDIUM":   { "type": "integer", "minimum": 0 },
        "LOW":      { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blocks_merge": { "type": "boolean" },
    "automated_checks": {
      "description": "Optional block for structured automated-check output. Fully optional — omit entirely for a reviewer with no automated tooling. The named sub-fields below are dotnet/Roslyn examples and none of them is required; a pack-specific schema extension may add its own automated-check fields.",
      "type": "object",
      "properties": {
        "roslyn_diagnostics":    { "type": "integer", "minimum": 0 },
        "antipatterns_detected": { "type": "array", "items": { "type": "string" } },
        "dead_code_count":       { "type": "integer", "minimum": 0 },
        "circular_deps":         { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "$schema": ".claude/schemas/impl-review.v1.json",
      "kind": "impl",
      "wi_id": "WI-1",
      "commit_range": "staged",
      "findings": [
        {
          "severity": "HIGH",
          "rule": "rules/csharp-style.md#guard-clauses",
          "file": "src/{Project}/Features/Tasks/ReassignTask.cs",
          "hunk": "@@ -24,6 +24,8 @@",
          "detail": "Missing guard clause for null supervisorId"
        }
      ],
      "summary": { "CRITICAL": 0, "HIGH": 1, "MEDIUM": 0, "LOW": 2 },
      "blocks_merge": true,
      "automated_checks": {
        "roslyn_diagnostics": 0,
        "antipatterns_detected": ["async-without-await:Line42"],
        "dead_code_count": 0,
        "circular_deps": 0
      }
    }
  ]
}
