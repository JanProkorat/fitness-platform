{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".claude/schemas/design-review.v1.json",
  "title": "Design Review v1",
  "type": "object",
  "required": ["$schema", "kind", "target", "findings", "summary", "blocks_merge"],
  "properties": {
    "$schema": { "const": ".claude/schemas/design-review.v1.json" },
    "kind":    { "const": "design" },
    "target":  { "type": "string", "description": "Path to the work-items doc being reviewed" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "rule", "citation", "detail"],
        "properties": {
          "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "rule":     { "type": "string", "maxLength": 200, "pattern": "^(rules/[a-z0-9-]+\\.md#[a-z0-9-]+|skills/[a-z0-9-]+/(SKILL\\.md|references/[a-z0-9-]+\\.md)#[a-z0-9-]+|CLAUDE\\.md → [A-Za-z0-9_. -]+)$", "description": "Descriptive anchor reference, e.g. 'rules/api-design.md#send-pattern' or 'CLAUDE.md → FastEndpoints Pattern'" },
          "citation": { "type": "string", "maxLength": 400, "description": "work-items.md:LINE or spec.md:LINE" },
          "detail":   { "type": "string", "minLength": 5, "maxLength": 2000 }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
      "properties": {
        "CRITICAL": { "type": "integer", "minimum": 0 },
        "HIGH":     { "type": "integer", "minimum": 0 },
        "MEDIUM":   { "type": "integer", "minimum": 0 },
        "LOW":      { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blocks_merge": { "type": "boolean", "description": "true iff CRITICAL+HIGH > 0" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "$schema": ".claude/schemas/design-review.v1.json",
      "kind": "design",
      "target": "docs/specs/in-progress/042_UC_reassign-task-work-items.md",
      "findings": [
        {
          "severity": "CRITICAL",
          "rule": "rules/architecture.md#vertical-slice-layout",
          "citation": "042_UC_reassign-task-work-items.md:74",
          "detail": "WI-5 violates Vertical Slice: mixes API and persistence concerns"
        }
      ],
      "summary": { "CRITICAL": 1, "HIGH": 0, "MEDIUM": 2, "LOW": 4 },
      "blocks_merge": true
    }
  ]
}
