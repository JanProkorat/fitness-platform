{
  "expo": {
    "name": "Form Up",
    "slug": "form-up",
    "owner": "proky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "formup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.formup.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "cs": "./native-locales/cs.json",
      "en": "./native-locales/en.json",
      "de": "./native-locales/de.json"
    },
    "android": {
      "package": "com.formup.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", {}],
      "expo-localization",
      "expo-secure-store",
      ["expo-notifications", {}],
      [
        "expo-image-picker",
        {
          "photosPermission": "Form Up uses your photos to upload your progress pictures.",
          "cameraPermission": "Form Up uses the camera to take your progress pictures.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8accb491-0ce3-4c0d-bf3d-aef883ed202a"
      }
    }
  }
}
