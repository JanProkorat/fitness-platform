# Template for .env.test — copy to .env.test (gitignored) before `npm run e2e:up`.
# These values are consumed by docker-compose.test.yml via env_file.

# JWT signing key for the packaged backend (must be ≥32 chars).
JWT_SECRET=replace-with-a-32-char-or-longer-test-secret

# Password used by QaSeedRunner when creating the deterministic QA users
# (qa.client@, qa.trainer@, qa.nutri@). qa-tester logs in with this value.
QA_SEED_PASSWORD=replace-me
