{
  "mcpServers": {
    "xcodebuildmcp": {
      "command": "npx",
      "args": ["-y", "xcodebuildmcp@latest", "mcp"]
    },
    "github": {
      "command": ".claude/scripts/with-keychain-secret.sh",
      "args": [
        "Claude Code GitHub PAT",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    }
  }
}
